{
  "name": "resona",
  "productName": "Resona",
  "version": "1.7.5",
  "description": "Resona — free music streaming desktop app",
  "main": "main.js",
  "author": {
    "name": "Resona",
    "email": "resona@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "resedit": "^3.1.0"
  },
  "build": {
    "appId": "app.resona.desktop",
    "productName": "Resona",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "afterPack": "afterpack.cjs",
    "extraResources": [
      {
        "from": "staging/server",
        "to": "server"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "staging/yt-dlp.exe",
          "to": "yt-dlp.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Resona-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "artifactName": "Resona-${version}-${arch}.dmg",
      "identity": null,
      "extraResources": [
        {
          "from": "staging/yt-dlp",
          "to": "yt-dlp"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "artifactName": "Resona-${version}.${ext}",
      "extraResources": [
        {
          "from": "staging/yt-dlp",
          "to": "yt-dlp"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "carlsibug98-spec",
        "repo": "Resona"
      }
    ]
  },
  "homepage": "https://github.com/carlsibug98-spec/Resona",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
